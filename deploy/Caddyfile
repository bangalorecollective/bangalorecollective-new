# HTTPS in front of the app. Caddy gets and renews the certificate itself.
#
# The staging address is password protected and hidden from search engines: it runs on a copy
# of real customer data and must not compete with the real shop in Google.

{$SITE_HOST} {
	# Staging only. Remove these two blocks when this file serves the real domain.
	basic_auth {
		{$STAGING_USER} {$STAGING_PASSWORD_HASH}
	}
	header X-Robots-Tag "noindex, nofollow"

	encode zstd gzip
	request_body {
		max_size 320MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Payment proofs are private: the app checks who is asking.
	handle /storage/v1/object/public/payment-proofs/* {
		reverse_proxy app:3000
	}

	# Every other uploaded file is public and served straight from disk.
	handle_path /storage/v1/object/public/* {
		root * /data/uploads
		header Cache-Control "public, max-age=86400"
		file_server
	}

	handle {
		reverse_proxy app:3000
	}
}

# Owner tools: database viewer and file viewer. Its own page lock (kept after go-live), then each
# tool's own sign-in. Never indexed.
{$TOOLS_HOST} {
	basic_auth {
		{$TOOLS_USER} {$TOOLS_PASSWORD_HASH}
	}
	header {
		X-Robots-Tag "noindex, nofollow"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		# pgAdmin needs the Referer header on its own requests; "no-referrer" leaves it blank.
		Referrer-Policy same-origin
		-Server
	}
	encode zstd gzip

	# One home page with a button for each tool (deploy/launcher.html).
	handle / {
		root * /srv/launcher
		rewrite * /launcher.html
		file_server
	}

	handle /pgadmin* {
		reverse_proxy pgadmin:80
	}
	handle /files* {
		reverse_proxy filebrowser:8080
	}
	handle {
		respond "Not found" 404
	}
}
