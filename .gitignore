# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# uploaded files and database imports (customer data, never committed)
/.uploads/
/.image-cache/
/deploy/import/

# local Claude Code settings
.claude/settings.local.json

# credentials and signing keys kept on disk from the old project; never commit
envfile
email and password
release.keystore
raw_base64.txt
*.keystore
*.jks
keystore.properties

# typescript
*.tsbuildinfo
next-env.d.ts

# Owner notes with logins; never committed.
/private/
